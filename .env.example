# ========================================================
# Money Ledger Environment Configuration
# ========================================================

# Server Port
PORT=4010

# Application URL & Name (Optional, defaults to http://localhost:3000)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="함께 쓰는 가계부"
NEXT_PUBLIC_APP_AUTHOR="Money Ledger"

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://money_user:money_password@localhost:5432/money_db?schema=public"

# Dedicated Session JWT Secret (Minimum 32 characters random string)
JWT_SECRET="money_ledger_jwt_secret_change_me_in_production"

# Personal API Key / Android Push Key
CARD_API_KEY="your_card_api_key_here"

# Batch Cron Secret (Daily / Monthly Slack Report)
CRON_SECRET="your_cron_secret_here"

# Slack Webhook URL for Daily & Monthly Reports (Optional)
SLACK_CARD_WEBHOOK_URL="https://hooks.slack.com/services/..."

# WebAuthn / Passkey Settings
# Set WEBAUTHN_ORIGIN to your exact public origin (e.g. https://money.your-domain.com or http://localhost:4010)
# Set WEBAUTHN_RP_ID to your domain name (e.g. money.your-domain.com or localhost)
WEBAUTHN_ORIGIN="http://localhost:4010"
WEBAUTHN_RP_ID="localhost"

# Kakao Login (Optional)
# Register the JavaScript SDK domain and exact OAuth callback URI in Kakao Developers
NEXT_PUBLIC_KAKAO_JS_KEY=""
KAKAO_REST_API_KEY=""
KAKAO_CLIENT_SECRET=""
KAKAO_REDIRECT_URI="http://localhost:3000/api/auth/kakao/callback"

# Privacy Policy Operator & Contact (Required for production compliance)
PRIVACY_OPERATOR_NAME=""
PRIVACY_CONTACT_EMAIL=""

# CORS Allowed Origins (Comma separated, optional)
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:4010"

# Optional: Anonymous Analytics Collection Endpoint
# NEXT_PUBLIC_ANALYTICS_ENDPOINT="https://analytics.example.com/api/collect"

# Optional: Naver Search Advisor Verification Code
# NAVER_SITE_VERIFICATION=""
